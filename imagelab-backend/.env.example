# CORS allowed origins (JSON array)
CORS_ORIGINS=["http://localhost:3100"]

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/imagelab_db"

# Debug mode
DEBUG=false

# Global step inspection cache memory budget (bytes)
EXECUTION_CACHE_MAX_BYTES=157286400

# Per-execution total step inspection budget (bytes)
EXECUTION_CACHE_MAX_PER_RUN_BYTES=26214400

# Per-execution raw NumPy array budget before falling back to compressed bytes (bytes)
EXECUTION_CACHE_MAX_RAW_PER_RUN_BYTES=15728640
